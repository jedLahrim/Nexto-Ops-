{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "mail/templates/**/*",
        "watchAssets": true,
        "outDir": "dist/src"
      },
      {
        "include": "user/keys/**/*",
        "watchAssets": true,
        "outDir": "dist/src"
      },
      {
        "include": "i18n/**/*",
        "watchAssets": true,
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}